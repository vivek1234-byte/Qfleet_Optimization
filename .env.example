# QFleet — environment configuration
#
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored; this file is not, so never put a real secret here.
#
#     cp .env.example .env          # macOS / Linux
#     copy .env.example .env        # Windows
#
# Anything already exported in the shell wins over a value in `.env`.


# ---------------------------------------------------------------------------
# Accounts database
# ---------------------------------------------------------------------------
# Any SQLAlchemy URL. The default (used when this is unset) is a SQLite file at
# backend/data/qfleet.db, which needs no server and works offline.
#
# Leave this unset to use the default. Set it only to move the database
# somewhere else — and use an absolute path if you do, because a relative one
# is resolved against whatever directory you started the server from.
# QGF_DATABASE_URL=sqlite:///C:/Data/Qfleet_Optimization/backend/data/qfleet.db
#
# PostgreSQL — install the driver first: pip install "psycopg[binary]"
# QGF_DATABASE_URL=postgresql+psycopg://qfleet:CHANGE_ME@localhost:5432/qfleet
#
# Log every SQL statement. Noisy; debugging only.
# QGF_DB_ECHO=false


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing key for session tokens. REQUIRED in any real deployment — without it
# a random key is generated per process and everyone is logged out on restart.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
QGF_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_KEY

# QGF_JWT_ALGORITHM=HS256
# How long a sign-in lasts, in minutes. 720 = 12 hours.
# QGF_JWT_EXPIRE_MINUTES=720
# bcrypt cost factor. 12 is the usual production floor.
# QGF_BCRYPT_ROUNDS=12
# QGF_PASSWORD_MIN_LENGTH=8


# ---------------------------------------------------------------------------
# First administrator (used by `python -m backend.manage bootstrap`)
# ---------------------------------------------------------------------------
# Set these to create the first admin without typing a password on the command
# line. Remove the password from .env once the account exists.
# QGF_ADMIN_EMPLOYEE_ID=EMP001
# QGF_ADMIN_NAME=Fleet Administrator
# QGF_ADMIN_PASSWORD=CHANGE_ME
# QGF_ADMIN_DEPARTMENT=Operations


# ---------------------------------------------------------------------------
# API (unchanged from before — listed for completeness)
# ---------------------------------------------------------------------------
# QGF_DEBUG=false
# QGF_LOG_LEVEL=INFO
# QGF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
