# The frontend: built in node, served by nginx. Two stages so the image that
# ships is 50 MB of static files rather than 400 MB of node_modules.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# No VITE_API_BASE_URL on purpose. Unset, the app calls /api on its own
# origin, which is what nginx proxies. Baking an absolute URL in here would
# tie the image to one hostname.
RUN npm run build

FROM nginx:1.27-alpine
COPY aws/nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/conf.d/../nginx.conf.default
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
